<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.form.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="canal_venta"/>
                <field name="total_unidades"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_tree_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.list.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="canal_venta" optional="show"/>
                <field name="total_unidades" optional="show" sum="Total"/>
            </field>
        </field>
    </record>
</odoo>
